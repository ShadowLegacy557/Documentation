  {
    "namespace": "palladium",
    "path": "command_result",
    "name": "Command Result",
    "description": "Executes command(s) and compares the output to a number.",
    "fields": [
      {
        "key": "command",
        "type": {
          "type": "combined",
          "options": [
            "String",
            "String[]"
          ]
        },
        "description": "The command(s) that are being executed.",
        "required": true,
        "fallback": null
      },
      {
        "key": "comparator",
        "type": {
          "type": "enum",
          "values": [
            "EQUALS",
            "NOT",
            "LESS_THAN",
            "GREATER_THAN",
            "LESS_OR_EQUAL",
            "GREATER_OR_EQUAL"
          ]
        },
        "description": "The used number comparator.",
        "required": true,
        "fallback": null
      },
      {
        "key": "compare_to",
        "type": "Integer",
        "description": "The number it's being compared to.",
        "required": true,
        "fallback": null
      },
      {
        "key": "log",
        "type": "Boolean",
        "description": "Whether or not the command result is being logged.",
        "required": false,
        "fallback": null
      }
    ],
    "examples": [
      {
        "type": "palladium:command_result",
        "command": "say Hello World",
        "comparator": "=",
        "compare_to": 5
      }
    ]
  },
